# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
# Never commit the real `.env` file.

# --- Elasticsearch (required) -------------------------------------------
# URL of the Elasticsearch index that holds the DataSpace documents
REACT_APP_ES_DATASPACE_URL=https://your-elasticsearch-host:9200
REACT_APP_ES_DATASPACE_USER=your_es_username
REACT_APP_ES_DATASPACE_PASS=your_es_password

# --- Application URL (required) -----------------------------------------
# Base URL of the app, including the trailing slash. Used to build entity links.
# For local development with `npm run server` + `npm run start`:
REACT_APP_API_END_POINT=http://localhost:3000/

# --- Neo4j (optional: only needed for the /graph/* ontology routes) -----
# UBERON ontology database
NEO4J_PROTOCOL_UBERON=bolt
NEO4J_HOST_UBERON=localhost
NEO4J_PORT_UBERON=7687
NEO4J_USERNAME_UBERON=neo4j
NEO4J_PASSWORD_UBERON=your_neo4j_password

# NIFSTD ontology database
NEO4J_PROTOCOL_NIFSTD=bolt
NEO4J_HOST_NIFSTD=localhost
NEO4J_PORT_NIFSTD=7687
NEO4J_USERNAME_NIFSTD=neo4j
NEO4J_PASSWORD_NIFSTD=your_neo4j_password

# --- Analytics (optional) -----------------------------------------------
# Google Analytics tracking ID. Leave empty to disable tracking.
REACT_APP_GA_TRACKING_ID=
